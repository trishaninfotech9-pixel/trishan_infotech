ErrorDocument 404 /Trishan_Infotech/404_error.html

# Clean URLs: hide the .html extension in the address bar.
RewriteEngine On

# Redirect browser URLs ending in .html to the clean form (GET only).
RewriteCond %{REQUEST_METHOD} GET
RewriteCond %{THE_REQUEST} \s(.+?)\.html[\s?] [NC]
RewriteRule ^ %1 [R=301,L,NE]

# Internally serve the matching .html file for extensionless URLs.
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
